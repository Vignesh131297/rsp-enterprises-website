# Copy to .env.local for local development. On GitHub these come from repository variables
# (Settings > Secrets and variables > Actions > Variables) named EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID
# and EMAILJS_PUBLIC_KEY. The EmailJS public key is meant to be used in the browser; it is not a password.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
